---
import HotelSample from '../../components/samples/HotelSample.astro'
import PortfolioSample from '../../components/samples/PortfolioSample.astro'
import ShopSample from '../../components/samples/ShopSample.astro'

export function getStaticPaths() {
  return [{ params: { slug: 'ikon' } }, { params: { slug: 'shop' } }, { params: { slug: 'portfolio' } }]
}

const { slug } = Astro.params
if (slug !== 'ikon' && slug !== 'shop' && slug !== 'portfolio') {
  throw new Error(`Unexpected sample: ${String(slug)}`)
}
---

{slug === 'ikon' && <HotelSample lang="th" />}
{slug === 'shop' && <ShopSample lang="th" />}
{slug === 'portfolio' && <PortfolioSample lang="th" />}
